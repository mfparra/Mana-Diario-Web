# LLM — provedor temporário de testes (ver docs/LLM.md)
LLM_PROVEDOR=llm-server
MODO_TESTE=true
# llm-server compartilhado (docs/LLM.md §6). Dentro do podman compose os serviços entram na
# rede externa "llm-net" e usam http://llm:8081/v1. Rodando com "uv run" fora do container,
# use http://127.0.0.1:8081/v1.
LLM_BASE_URL=http://llm:8081/v1
LLM_API_KEY=
LLM_MODELO=gemma-4-e4b-it
LLM_TIMEOUT_S=120
# true liga o "thinking" do Gemma 4 (~5x mais lento; exige max_tokens maior)
LLM_PENSAR=false
LLM_VERSAO_PROMPT=estudo_diario.v1

# Bancos e arquivos (caminhos relativos à raiz do projeto, que é /app no container).
# No container, o compose sobrescreve MANA_DB e CALENDARIOS_DIR para dentro do volume /dados
# (AGENTS.md §13).
BIBLIA_DB=data/biblia/biblia.sqlite
MANA_DB=data/mana.sqlite
CALENDARIOS_DIR=data/calendarios

# Conteúdo
# "todas" ou lista separada por vírgula, ex.: pascoa,natal,corpus-christi (AGENTS.md §6.1)
OCASIOES_ATIVAS=todas

# Site
FUSO_HORARIO=America/Sao_Paulo
HOST=0.0.0.0
PORTA=8000
URL_PUBLICA=http://localhost:8000

# podman compose (arquivos criados na Fase 0)
MANA_TAG=dev
PORTA_HOST=8000
